{
    "type": "tabs",
    "i18n": true,
    "items": {
        "mainTab": {
            "type": "panel",
            "label": "Main settings",
            "items": {
                "bind": {
                    "type": "ip",
                    "listenOnAllPorts": true,
                    "label": "IP",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 5,
                    "xl": 5
                },
                "port": {
                    "type": "number",
                    "min": 1,
                    "max": 65565,
                    "label": "Port",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "secure": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Secure(HTTPS)",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 2,
                    "xl": 2
                },
                "http2": {
                    "type": "checkbox",
                    "label": "http2",
                    "help": "http2_hint",
                    "default": true,
                    "hidden": "!data.secure",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "auth": {
                    "newLine": true,
                    "type": "checkbox",
                    "confirm": {
                        "condition": "!data.secure && data.auth",
                        "title": "Warning!",
                        "text": "Unsecure_Auth",
                        "ok": "Ignore warning",
                        "cancel": "Disable authentication",
                        "type": "warning",
                        "alsoDependsOn": ["secure"]
                    },
                    "label": "Authentication",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 2,
                    "xl": 2
                },
                "authType": {
                    "type": "select",
                    "label": "Authentication type",
                    "options": [
                        { "label": "auth_type_basic", "value": "basic" },
                        { "label": "auth_type_digest", "value": "digest" }
                    ],
                    "default": "basic",
                    "hidden": "!data.auth",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "cwd": {
                    "newLine": true,
                    "type": "text",
                    "label": "Start directory",
                    "help": "Leave empty to use the ioBroker directory",
                    "placeholder": "/home/iobroker",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "shellUser": {
                    "newLine": true,
                    "type": "text",
                    "label": "Shell user",
                    "help": "Leave empty to use the ioBroker process user",
                    "placeholder": "root",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "sessionTimeout": {
                    "newLine": true,
                    "type": "number",
                    "min": 0,
                    "max": 1440,
                    "label": "Session timeout",
                    "help": "session_timeout_help",
                    "default": 5,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                }
            }
        },
        "leTab": {
            "type": "panel",
            "label": "Let's Encrypt SSL",
            "hidden": "!data.secure",
            "items": {
                "_image": {
                    "type": "staticImage",
                    "tooltip": "Read about Let's Encrypt certificates",
                    "href": "https://github.com/ioBroker/ioBroker.admin/blob/master/README.md#lets-encrypt-certificates",
                    "src": "../../img/le.png",
                    "style": {
                        "width": 200,
                        "height": 59
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_staticText": {
                    "type": "staticText",
                    "text": "ra_Use iobroker.acme adapter for letsencrypt certificates",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        }
    }
}
